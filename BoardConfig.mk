#
# BoardConfig for TWRP on Samsung Galaxy Tab 3 Lite 7.0 Wi-Fi (SM-T110 / goyawifi)
# SoC: Marvell PXA986 (PXA988 family, dual Cortex-A9 r3p0)
# Kernel: Linux 4.19 LTS (prebuilt)

DEVICE_PATH := device/samsung/goyawifi

# Architecture
TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_CPU_VARIANT := cortex-a9

# Platform
TARGET_BOARD_PLATFORM := pxa988
TARGET_BOOTLOADER_BOARD_NAME := PXA986
TARGET_NO_BOOTLOADER := true
TARGET_NO_RADIOIMAGE := true
TARGET_USES_64_BIT_BINDER := true

# Prebuilt Kernel & DTB
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/kernel/zImage
TARGET_PREBUILT_DTB := $(DEVICE_PATH)/kernel/pxa986-samsung-goyawifi.dtb

# Boot Image & Custom S-Boot FDT-Tail Packer
BOARD_KERNEL_BASE := 0x10000000
BOARD_KERNEL_OFFSET := 0x00008000
BOARD_RAMDISK_OFFSET := 0x01000000
BOARD_SECOND_OFFSET := 0x00f00000
BOARD_TAGS_OFFSET := 0x00000100
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_CMDLINE := console=ttyS0,115200n8 console=tty0 earlyprintk panic=5 printk.devkmsg=on firmware_class.path=/vendor/firmware androidboot.hardware=pxa988 androidboot.boot_devices=soc/d4200000.axi/d4281000.sdh androidboot.selinux=permissive
BOARD_MKBOOTIMG_ARGS += \
    --kernel_offset $(BOARD_KERNEL_OFFSET) \
    --ramdisk_offset $(BOARD_RAMDISK_OFFSET) \
    --second_offset $(BOARD_SECOND_OFFSET) \
    --tags_offset $(BOARD_TAGS_OFFSET)
BOARD_CUSTOM_BOOTIMG := true
BOARD_CUSTOM_BOOTIMG_MK := $(DEVICE_PATH)/bootimg/custom_bootimg.mk

# Partitions (Verified from SM-T110 eMMC GPT)
BOARD_BOOTIMAGE_PARTITION_SIZE := 16777216
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 16777216
BOARD_SYSTEMIMAGE_PARTITION_SIZE := 1594884096
BOARD_CACHEIMAGE_PARTITION_SIZE := 360710144
BOARD_USERDATAIMAGE_PARTITION_SIZE := 5509218304
BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_HAS_LARGE_FILESYSTEM := true
BOARD_SUPPRESS_SECURE_ERASE := true

# Filesystems (EXT4 + F2FS)
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
TARGET_USES_MKE2FS := true
TARGET_COPY_OUT_VENDOR := vendor
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs

# Recovery & Storage
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab
RECOVERY_SDCARD_ON_DATA := true
TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
TARGET_RECOVERY_DEFAULT_ROTATION := ROTATION_LEFT

# Display & TWRP UI
TARGET_SCREEN_WIDTH := 600
TARGET_SCREEN_HEIGHT := 1024
TW_THEME := portrait_mdpi
TW_ROTATION := 270
TW_BRIGHTNESS_PATH := "/sys/class/backlight/vx5b3d-backlight/brightness"
TW_MAX_BRIGHTNESS := 255
TW_DEFAULT_BRIGHTNESS := 128

# TWRP Features
TW_EXTRA_LANGUAGES := true
TW_DEFAULT_LANGUAGE := en
TW_USE_TOOLBOX := true
TW_INCLUDE_F2FS := true
TW_INCLUDE_NTFS_3G := true
TW_INCLUDE_FUSE_NTFS := true
TW_INCLUDE_FUSE_EXFAT := true
TW_INCLUDE_EXFAT := true
TW_INCLUDE_FB2PNG := true
TW_INCLUDE_REPACKTOOLS := true
TW_INCLUDE_RESETPROP := true
TW_INCLUDE_LIBRESETPROP := true
TW_INCLUDE_CRYPTO := true
TW_HAS_DOWNLOAD_MODE := true
TW_NO_REBOOT_BOOTLOADER := true
TW_NO_HAPTICS := true
TW_BATTERY_SYSFS_WAIT_SECONDS := 5
TW_EXCLUDE_APEX := true

# Logging & Debugging
TWRP_INCLUDE_LOGCAT := true
TARGET_USES_LOGD := true
